# 复制为 .env 后替换所有 replace-with-* 和 example.internal 值。
# MySQL 用户必须只授予 SELECT 权限；密码中的特殊字符需要 URL 编码。
DATA_MODE=readonly_db
# 1=自动执行通过安全校验的只读 SQL；其他值=每条 SQL 都需终端人工批准。
AUTO_QUERY_MODE=0
MODEL_MODE=deepseek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MYSQL_STAT_URL=mysql+asyncmy://readonly_user:replace-with-password@db20.example.internal:3306/au_stat?charset=utf8mb4
MYSQL_CONFIG_URL=mysql+asyncmy://readonly_user:replace-with-password@db40.example.internal:3306/ymgw?charset=utf8mb4
STAT_TIMEZONE=UTC
CLI_TIMEZONE=Asia/Shanghai
MODEL_TIMEOUT_SECONDS=30
ARTIFACTS_DIR=artifacts
FIXTURE_DIR=../fixtures/demo
